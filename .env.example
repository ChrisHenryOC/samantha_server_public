# Environment-variable template for samantha_server.
#
# Copy to .env (gitignored) for local development. Variables are grouped
# by phase and concern. Required-secret variables appear as commented lines
# with a generation-command comment above each.
#
# Convention: values are quoted (KEY="value"). Comment lines begin with '#'.

# ============================================================================
# Test runner
# ============================================================================
#
# Set to "1" to disable the no-network guard installed by
# conftest.py::_forbid_real_network. The guard blocks outbound
# connections to non-loopback hosts during the test session, catching
# accidental cloud-API calls that shouldn't happen in this codebase.
# Leave UNSET in normal use.
# ALLOW_REAL_NETWORK=

# ============================================================================
# Phase 2 — LLM client
# ============================================================================
#
# Configure the local LLM used for inference. No cloud API keys —
# this project does not call cloud LLM APIs by design.
#
# oMLX client (default provider since Amendment A1, 2026-05-09):
# Talks to a same-host oMLX server over loopback HTTP. The host must be
# loopback (localhost or a 127.x.x.x / ::1 address). See
# docs/plans/phase-2-amendment-omlx.md for rationale.

# LLM_PROVIDER: which client implementation to use.
# Default: omlx (loopback HTTP to oMLX server). Also supported: mlx (in-process).
# LLM_PROVIDER="omlx"

# LLM_OMLX_BASE_URL: base URL for the oMLX OpenAI-compatible server.
# Host MUST be loopback (validated at import). Default: http://127.0.0.1:8000
# LLM_OMLX_BASE_URL="http://127.0.0.1:8000"

# LLM_OMLX_AUTH_TOKEN: optional bearer token for oMLX authentication.
# Empty string or unset = no Authorization header. Never a cloud API key.
# LLM_OMLX_AUTH_TOKEN=""

# LLM_OMLX_TIMEOUT_S: HTTP request timeout in seconds for oMLX calls. Default 120.
# LLM_OMLX_TIMEOUT_S="120.0"

# LLM_MODEL_PATH: model identifier or local path.
# LLM_MODEL_PATH="mlx-community/Llama-3.2-3B-Instruct-4bit"

# LLM_MODEL_NAME: human-readable name; defaults to LLM_MODEL_PATH.
# Set to a scrubbed identifier if LLM_MODEL_PATH is a local filesystem path
# you'd rather not see in audit logs.
#
# Recommended baseline:
# LLM_MODEL_NAME="Qwen3-Next-80B-A3B-Instruct-4bit"
#
# Selected model retest. Full-corpus N=5 result: 147/149 (98.66%)
# stable; unlocks LR-006 and QR-024 vs the prior Gemma baseline. Hardware
# requirement: ~45 GB resident on Apple Silicon (64 GB unified memory verified).
# LLM_MODEL_NAME=""

# LLM_TEMPERATURE: float; default 0.0.
# LLM_TEMPERATURE="0.0"

# LLM_MAX_TOKENS: int; default 2048.
# LLM_MAX_TOKENS="2048"

# LLM_JUDGE_MODEL_PATH: optional; Stage B grounded-check model (Step 11).
# LLM_JUDGE_MODEL_PATH=""

# ============================================================================
# Phase 2 — required secrets (eager-validated at config import)
# ============================================================================
#
# These variables must be set before the server starts. Generate fresh values
# using the commands shown above each entry. Do NOT commit real secret values.

# Generate with: python -m samantha_server.receipts.signing --gen-key
# RECEIPT_SIGNING_KEY=""

# Set ONLY during a key-rotation window; unset on routine startup.
# RECEIPT_SIGNING_KEY_PREVIOUS=""

# Increment on every rotation (v1 → v2 → ...). Default "v1".
# RECEIPT_SIGNING_KEY_ID="v1"

# Generate with: python -c 'import os; print(os.urandom(32).hex())'
# PHI_HASH_SALT=""

# ============================================================================
# Phase 2 — debug toggles (default false; do NOT set in CI / production)
# ============================================================================
#
# These variables are for local debugging only. Never set them in CI or
# production deployments.

# SCENARIO_LOADER_TOLERATE_MALFORMED: when true, malformed scenario files
# downgrade from raise to warn-and-skip. Debug-only; CI must not set it.
# SCENARIO_LOADER_TOLERATE_MALFORMED="false"

# RECEIPTS_DB_PATH: path to the SQLite receipts database.
# Default: ~/.samantha_server/receipts.db
# RECEIPTS_DB_PATH=""

# ============================================================================
# Phase 3 — orchestrator
# ============================================================================
#
# Configuration for the FastAPI orchestrator service introduced in Phase 3.
# All values have safe defaults; override only when needed.

# QUEUE_BOUND: maximum events in the priority queue before overflow rejections.
# Must be > 0. Default: 256.
# QUEUE_BOUND="256"

# QUEUE_BACKPRESSURE_RETRY_AFTER_SEC: seconds to suggest the caller wait when
# the queue is full. Default: 5.
# QUEUE_BACKPRESSURE_RETRY_AFTER_SEC="5"

# WEB_CONCURRENCY: Uvicorn worker count. Must be 1 for v0 (tracks
# multi-worker support). Default: 1.
# WEB_CONCURRENCY="1"

# MAX_REQUEST_BODY_BYTES: maximum request body size in bytes. Default: 1048576 (1 MiB).
# MAX_REQUEST_BODY_BYTES="1048576"

# READYZ_LANGFUSE_PROBE_TTL_SEC: TTL for the Langfuse readiness probe cache.
# Default: 5.
# READYZ_LANGFUSE_PROBE_TTL_SEC="5"

# READYZ_LANGFUSE_PROBE_TIMEOUT_SEC: per-call probe timeout in seconds.
# Default: 0.5. Raise on slower lab links; on loopback the default is fine.
# READYZ_LANGFUSE_PROBE_TIMEOUT_SEC="0.5"

# SCENARIOS_DIR: absolute path to the scenarios corpus loaded at lifespan
# startup. Defaults to the in-repo `samantha_server/scenarios/` package
# directory — which carries no built-in corpus today. Set this to point at
# the fixture corpus (tests/fixtures/scenarios/) or a vendored / external
# corpus. Lifespan refuses paths under /etc, /proc, /sys, /dev.
# SCENARIOS_DIR=""

# SHUTDOWN_DRAIN_TIMEOUT_SEC: graceful-shutdown drain window in seconds.
# Default: 30.
# SHUTDOWN_DRAIN_TIMEOUT_SEC="30"

# EVENT_DISPATCH_TIMEOUT_SEC: maximum seconds the POST /events handler waits
# for the consumer to resolve a dispatch future. Returns 504 on timeout.
# Default: 60.
# EVENT_DISPATCH_TIMEOUT_SEC="60"

# ============================================================================
# Phase 3 — RBAC + dispatch token
# ============================================================================
#
# Authentication and authorization for the orchestrator API.
#
# RBAC_HMAC_KEY is REQUIRED. Generate a fresh value on each deployment.
# RBAC_TOKEN_TTL_SEC and DISPATCH_TOKEN_TTL_SEC have safe defaults.

# Generate with: python -c 'import os; print(os.urandom(32).hex())'
# RBAC_HMAC_KEY=""

# RBAC_TOKEN_TTL_SEC: seconds a capability token is valid. Default 86400 (24h).
# Must be > 0.
# RBAC_TOKEN_TTL_SEC="86400"

# DISPATCH_TOKEN_TTL_SEC: seconds a dispatch token is valid. Default 60.
# Must be > 0.
# DISPATCH_TOKEN_TTL_SEC="60"

# ============================================================================
# Phase 3 — observability (Langfuse)
# ============================================================================
#
# Langfuse trace export is ENABLED by default. true requires provisioned
# keys + OTEL_EXPORTER_OTLP_ENDPOINT or startup is fatal (fail-loud) — set
# LANGFUSE_ENABLED="false" to run without a Langfuse instance (e.g. a
# keyless laptop). The test suite pins "false" in tests/conftest.py.
#
# LANGFUSE_BASE_URL must be a loopback http:// URL (validated at import).
# The default mirrors the docker-compose setup (127.0.0.1, port 3000).

# LANGFUSE_ENABLED="true"
# LANGFUSE_BASE_URL="http://localhost:3000"
# LANGFUSE_PUBLIC_KEY=""
# LANGFUSE_SECRET_KEY=""
# OTEL_EXPORTER_OTLP_ENDPOINT=""

# ============================================================================
# Phase 3 — drift alarm
# ============================================================================
#
# Drift alarm webhook target for operational alerting. Step 12 wires this.

# DRIFT_ALARM_WEBHOOK_URL=""
# DRIFT_ALARM_THRESHOLD="0.05"
# DRIFT_ALARM_WINDOW_SEC="3600"
# DRIFT_ALARM_CHECK_INTERVAL_SEC="60"
# DRIFT_DEQUE_MAXLEN="100000"
